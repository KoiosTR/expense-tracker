<?xml version="1.0" encoding="UTF-8"?>

import javafx.geometry.Insets?>
import javafx.scene.control.*?>
import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.expense.controller.MainController" styleClass="main-pane">
    <top>
        <HBox spacing="15" alignment="CENTER_LEFT" styleClass="top-bar">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <Label text="Harcamalarım" styleClass="header-label"/>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Kategorileri Yönet" onAction="#manageCategories" styleClass="action-button"/>
            <Button text="Çıkış Yap" onAction="#logout" styleClass="danger-button"/>
        </HBox>
    </top>
    
    <center>
        <VBox spacing="10">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="Yeni Harcama Ekle" onAction="#openAddExpense" styleClass="primary-button"/>
                <Button text="Düzenle" onAction="#openEditExpense" styleClass="secondary-button"/>
                <Button text="Sil" onAction="#deleteExpense" styleClass="danger-button"/>
                <Region HBox.hgrow="ALWAYS" />
                <Button text="CSV'ye Aktar" onAction="#exportToCsv" styleClass="action-button"/>
            </HBox>

            <TableView fx:id="expenseTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="dateCol" text="Tarih" prefWidth="100"/>
                    <TableColumn fx:id="categoryCol" text="Kategori" prefWidth="150"/>
                    <TableColumn fx:id="descriptionCol" text="Açıklama" prefWidth="250"/>
                    <TableColumn fx:id="amountCol" text="Tutar" prefWidth="100"/>
                    <TableColumn fx:id="currencyCol" text="Para Birimi" prefWidth="80"/>
                    <TableColumn fx:id="amountTlCol" text="Tutar (TL)" prefWidth="100"/>
                </columns>
            </TableView>
        </VBox>
    </center>
    
    <bottom>
        <HBox alignment="CENTER_RIGHT" styleClass="bottom-bar">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <Label fx:id="totalLabel" text="Toplam Harcama (TL): 0.00" styleClass="total-label"/>
        </HBox>
    </bottom>
</BorderPane>
